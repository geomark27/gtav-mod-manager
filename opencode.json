{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permission": {
    "edit": "deny",
    "webfetch": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "git *": "deny",
      "npm uninstall*": "deny",
      "pnpm *": "deny",
      "yarn *": "deny",
      "pip install*": "deny",
      "cargo install*": "deny",
      "cargo add*": "deny",
      "cargo remove*": "deny",
      "cargo update*": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rm *": "deny",
      "mv *": "deny",
      "sudo *": "deny"
    }
  }
}
