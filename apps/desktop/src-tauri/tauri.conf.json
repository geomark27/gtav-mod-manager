{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTA V Mod Manager",
  "version": "0.3.0",
  "identifier": "com.kaelence.gtavmodmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GTA V Mod Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kaelence",
    "shortDescription": "Safe mod manager for GTA V Legacy and Enhanced (story mode)",
    "longDescription": "GTA V Mod Manager inventories and toggles story-mode mods for GTA V Legacy and Enhanced without ever touching original game files: every change is journaled, verified and reversible. Mods managed here are for story mode only; disabling mods does not make an installation safe for GTA Online.",
    "category": "Utility",
    "copyright": "© 2026 Kaelence",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDMTY5MTMwMTJGMDUzMDUKUldRRlUvQVNNSkVXWEFuYm5JdW5IMDZjWXovaUd5eTlUTG9NNllXNW82ZUV3OGpVakpPK0NpZ1QK",
      "endpoints": [
        "https://github.com/geomark27/gtav-mod-manager/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
